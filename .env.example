# DyslexAI environment template
# Copy values into dyslexia-backend/.env for backend runtime.
# Frontend values can be placed in frontend/.env.

# -----------------------------
# Backend (required)
# -----------------------------
DATABASE_URL=sqlite:///./dyslexia.db
JWT_SECRET=change-this-in-production
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional but recommended for account migration and admin signup flow
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required for teacher signup when role=teacher
TEACHER_SECRET_CODE=TEACH2024

# -----------------------------
# OCR / model settings
# -----------------------------
OCR_MODE=notebook_parity
QUALITY_MODE=quality_local
PADDLE_LANG=en
TROCR_MODEL_NAME=microsoft/trocr-large-handwritten
BYT5_MODEL_NAME=google/byt5-small
TROCR_FAST=0
TROCR_WORKERS=4
DYSLEXAI_TROCR_WARMUP=0
DYSLEXAI_T5_MODEL_PATH=

# Optional tuning
DYSLEXAI_DEBUG=0
DYSLEXAI_EASY_THRESHOLD=0.5
DYSLEXAI_HARD_THRESHOLD=1.8

# -----------------------------
# LLM / Groq (optional features)
# -----------------------------
GROQ_API_KEY=your-groq-api-key
# Optional separate key for vision correction. Falls back to GROQ_API_KEY.
GROQ_VISION_API_KEY=

# -----------------------------
# Frontend (place in frontend/.env)
# -----------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_EXERCISES_API=http://localhost:8000
VITE_SESSIONS_API=http://localhost:8000
