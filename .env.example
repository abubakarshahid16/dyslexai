# DyslexAI environment template
# ── Local dev: copy this to dyslexia-backend/.env ──────────────────────────
# ── HuggingFace Spaces: add these as Repository Secrets in Space settings ──

# -----------------------------
# Database
# -----------------------------
# Local dev - SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./dyslexia.db
# Production - Supabase PostgreSQL (uncomment and fill in)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# -----------------------------
# Auth
# -----------------------------
JWT_SECRET=change-this-to-a-long-random-string-in-production
TEACHER_SECRET_CODE=TEACH2024

# -----------------------------
# Supabase
# -----------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------
# OCR / Model settings
# -----------------------------
OCR_MODE=notebook_parity
# Local dev - use local finetuned model folder
TROCR_MODEL_NAME=app/finetuned_model
# HuggingFace Spaces deployment - use HF Hub repo (also set HF_TOKEN)
# TROCR_MODEL_NAME=your-hf-username/dyslexai-trocr-finetuned
DYSLEXAI_TROCR_WARMUP=0

# -----------------------------
# HuggingFace Hub token (only needed in HF Spaces to load private model)
# -----------------------------
# HF_TOKEN=hf_your_token_here

# -----------------------------
# LLM / Groq
# -----------------------------
GROQ_API_KEY=your-groq-api-key
GROQ_API_KEY_2=

# -----------------------------
# Frontend (place in frontend/.env.local for local dev)
# Netlify -> set VITE_API_BASE_URL in Netlify dashboard env vars
# -----------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_EXERCISES_API=http://localhost:8000
VITE_SESSIONS_API=http://localhost:8000
